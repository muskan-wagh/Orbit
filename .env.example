# Supabase (required for auth + database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service role key. NOT for browser code.
# SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Phase 4 — Gmail connection)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenAI (Phase 5 — email classification/extraction)
# OPENAI_API_KEY=

# Base URL used for OAuth redirects (local dev)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
