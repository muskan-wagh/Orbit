# Supabase (required for auth + database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service role key. NOT for browser code.
# SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — Gmail connection (Phase 4)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API and add GOOGLE_REDIRECT_URI as an authorized redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI provider (Phase 5 — email classification/extraction)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Base URL used for OAuth redirects (local dev)
# NEXT_PUBLIC_APP_URL=http://localhost:3000